{
  "name": "@ain-rider/test-utils",
  "version": "1.0.0",
  "description": "Integration test harness for 911 Ain Rider backend: test databases, infra clients, and test env defaults",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "tsc --build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ain-rider/minio-client": "workspace:*",
    "@ain-rider/nats-client": "workspace:*",
    "@ain-rider/redis-client": "workspace:*",
    "minio": "^8.0.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
