/// Migration strategy:
/// - All schema changes must be backward-compatible (additive columns, nullable fields).
/// - Renames require a two-step migration: add new column → backfill → drop old column.
/// - Deprecated fields should be marked with a /// DEPRECATED comment and removed after a full release cycle.
/// - Coordinate multi-service schema changes via NATS event versioning (new fields = new event version).
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors UserRole from auth-service for local typed queries on shadow data.
enum ShadowUserRole {
  RIDER
  DRIVER
  ADMIN
  SUPPORT
}

/// Mirrors UserStatus from auth-service plus DELETED for soft-delete tracking.
enum ShadowUserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DOCUMENTS
  UNDER_REVIEW
  REJECTED
  DELETED
}

/// Admin-side vehicle verification status (distinct from auth-service DocumentStatus).
enum VehicleStatus {
  ACTIVE
  PENDING
  SUSPENDED
  INACTIVE
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Withdrawal lifecycle. Note: PROCESSED (not COMPLETED) is the terminal success state.
enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum PromoType {
  PERCENTAGE
  FLAT
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum SOSPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Tracks the sync health of a shadow user record relative to auth-service.
enum SyncStatus {
  SYNCED
  PENDING
  FAILED
}

/// Shadow copy of users from auth-service, kept in sync via NATS USER_* events.
/// admin-service NEVER queries auth-service over HTTP for user data — all reads come from this table.
/// Falls back to HTTP only when a user hasn't been synced yet (findById).
model UserShadow {
  id           String           @id
  email        String           @unique
  phoneNumber  String
  firstName    String
  lastName     String
  role         ShadowUserRole
  status       ShadowUserStatus @default(ACTIVE)
  profileImage String?
  /// Sync health indicator — FAILED records should be retried via consumer error handling.
  syncStatus   SyncStatus       @default(SYNCED)
  /// Last sync error message, populated when syncStatus = FAILED.
  syncError    String?
  syncedAt     DateTime         @default(now())
  createdAt    DateTime
  updatedAt    DateTime

  @@index([role])
  @@index([status])
  @@index([role, status])
  @@index([phoneNumber])
  @@index([firstName])
  @@index([lastName])
  @@map("shadow_users")
}

/// Vehicle type/category defining fare structure (e.g., sedan, SUV, van).
model VehicleType {
  id            String         @id @default(uuid())
  name          String
  type          String
  baseFare      Float
  perKmRate     Float
  perMinuteRate Float
  minFare       Float
  maxPassengers Int
  imageUrl      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vehicles      Vehicle[]
  models        VehicleModel[]

  @@map("vehicle_types")
}

/// Vehicle manufacturer (e.g., Toyota, Hyundai) for dropdown selections.
model VehicleMake {
  id        String         @id @default(uuid())
  name      String         @unique
  isActive  Boolean        @default(true)
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("vehicle_makes")
}

/// Specific vehicle model (e.g., "Camry") linked to a make and optional vehicle type.
model VehicleModel {
  id            String   @id @default(uuid())
  makeId        String
  name          String
  vehicleTypeId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  make        VehicleMake  @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)

  @@unique([makeId, name])
  @@map("vehicle_models")
}

/// Admin-managed vehicle record with full registration and insurance details.
/// Distinct from auth-service Vehicle which is driver-uploaded during onboarding.
model Vehicle {
  id                 String        @id @default(uuid())
  driverId           String
  vehicleTypeId      String
  make               String
  model              String
  year               Int
  color              String
  licensePlate       String        @unique
  registrationNumber String        @unique
  insuranceNumber    String
  insuranceExpiry    DateTime
  status             VehicleStatus @default(ACTIVE)
  imageUrl           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  vehicleType        VehicleType   @relation(fields: [vehicleTypeId], references: [id])

  @@map("vehicles")
}

/// Driver wallet for earnings management. All amounts in EGP.
model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Float               @default(0)
  currency     String              @default("EGP")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@map("wallets")
}

/// Immutable ledger entry for wallet balance changes.
/// balanceBefore + amount (CREDIT) = balanceAfter; balanceBefore - amount (DEBIT) = balanceAfter.
model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  userId        String
  type          WalletTransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  status        WalletTransactionStatus @default(COMPLETED)
  description   String
  /// Links to the source entity (tripId, withdrawalId, etc.).
  referenceId   String?
  createdAt     DateTime                @default(now())
  wallet        Wallet                  @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([walletId, type])
  @@index([status, createdAt])
  @@map("wallet_transactions")
}

/// Driver withdrawal request to bank account. Processed by admins.
model Withdrawal {
  id                String           @id @default(uuid())
  userId            String
  walletId          String
  amount            Float
  status            WithdrawalStatus @default(PENDING)
  bankAccountNumber String
  bankName          String
  accountHolderName String
  requestedAt       DateTime         @default(now())
  processedAt       DateTime?
  processedBy       String?
  rejectionReason   String?
  transactionId     String?
  wallet            Wallet           @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

/// Promotional code with usage limits and validity window.
model Promo {
  id                String       @id @default(uuid())
  code              String       @unique
  type              PromoType
  value             Float
  maxDiscount       Float?
  minTripAmount     Float?
  maxUsagePerUser   Int          @default(1)
  totalUsageLimit   Int
  currentUsageCount Int          @default(0)
  status            PromoStatus  @default(ACTIVE)
  validFrom         DateTime
  validUntil        DateTime
  description       String
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  usages            PromoUsage[]

  @@index([code])
  @@index([status])
  @@map("promos")
}

/// Tracks individual promo code redemptions per user per trip.
model PromoUsage {
  id             String   @id @default(uuid())
  promoId        String
  userId         String
  tripId         String
  discountAmount Float
  usedAt         DateTime @default(now())
  promo          Promo    @relation(fields: [promoId], references: [id])

  @@index([userId])
  @@index([promoId, userId])
  @@map("promo_usages")
}

/// Notification record. Supports broadcast (userId=null) and targeted delivery.
model Notification {
  id          String               @id @default(uuid())
  userId      String?
  type        String
  priority    NotificationPriority @default(MEDIUM)
  status      NotificationStatus   @default(PENDING)
  title       String
  body        String
  data        Json?
  imageUrl    String?
  actionUrl   String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdBy   String
  createdAt   DateTime             @default(now())
  reads       NotificationRead[]

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

/// Tracks who has read a notification — supports admin reads without affecting the target user's read status.
model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  readerId       String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, readerId])
  @@index([readerId])
  @@map("notification_reads")
}

/// Admin-side SOS alert with response tracking and emergency contact details.
model SOS {
  id                String      @id @default(uuid())
  userId            String
  tripId            String?
  status            String      @default("ACTIVE")
  priority          SOSPriority @default(CRITICAL)
  latitude          Float
  longitude         Float
  address           String
  reason            String?
  notes             String?
  /// JSON array of emergency contact objects { name, phone, relation }.
  emergencyContacts Json
  respondedBy       String?
  responseNotes     String?
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("sos_alerts")
}

/// User-submitted complaint against another user, trip, or platform issue.
model Complaint {
  id              String             @id @default(uuid())
  complainantId   String
  complainantRole String
  againstUserId   String?
  tripId          String?
  type            String
  status          ComplaintStatus    @default(PENDING)
  priority        String             @default("MEDIUM")
  subject         String
  description     String
  evidence        Json?
  assignedTo      String?
  resolution      String?
  resolutionNotes String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resolvedAt      DateTime?
  comments        ComplaintComment[]

  @@index([complainantId])
  @@index([status])
  @@map("complaints")
}

/// Internal or public comment on a complaint thread. isInternal=true for admin-only notes.
model ComplaintComment {
  id          String    @id @default(uuid())
  complaintId String
  userId      String
  userRole    String
  comment     String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  @@map("complaint_comments")
}

/// Defines the value type for runtime parsing/validation of the setting value field.
enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/// Platform-wide configuration key-value store with type hints for safe parsing.
model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  category    String
  description String
  isPublic    Boolean     @default(false)
  updatedBy   String
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@map("settings")
}

/// Scheduled ride booking for future pickup.
model Booking {
  id             String        @id @default(uuid())
  riderId        String
  driverId       String?
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  scheduledAt    DateTime?
  status         BookingStatus @default(PENDING)
  fare           Float?
  paymentMethod  String
  notes          String?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([riderId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}

/// Immutable audit trail for all admin actions. Used for compliance and debugging.
model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String
  action        String
  /// Entity type being acted upon (e.g., "USER", "TRIP", "SETTING").
  targetType    String
  targetId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([action])
  @@map("admin_audit_logs")
}
