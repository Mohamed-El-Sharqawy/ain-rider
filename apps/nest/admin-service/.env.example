DATABASE_URL=postgresql://ainrider:password@pgbouncer:5432/ainrider
ADMIN_SERVICE_PORT=4003
JWT_SECRET=change-me-in-production
NATS_URL=nats://nats:4222
REDIS_NODES=redis-0.redis-headless:6379,redis-1.redis-headless:6379,redis-2.redis-headless:6379

# MinIO Object Storage (on-premise, S3-compatible)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_DEFAULT_BUCKET=ain-rider
# TTL for presigned URLs in seconds (default: 1 hour)
MINIO_PRESIGNED_TTL=3600

# CORS allowed origins (comma-separated, use * for all origins in dev only)
CORS_ORIGIN=http://localhost:5173,https://admin.ainrider.iq

NODE_ENV=development
