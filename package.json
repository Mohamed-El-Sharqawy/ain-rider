{
  "name": "ain-rider-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "node scripts/lint.mjs",
    "lint:turbo": "turbo run lint",
    "typecheck": "node scripts/typecheck.mjs",
    "format:check": "prettier --check --ignore-unknown",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "prisma:generate": "pnpm -C apps/backend prisma:generate",
    "docker:infra:up": "pnpm -C apps/backend docker:infra:up",
    "docker:infra:down": "pnpm -C apps/backend docker:infra:down"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "react": "19.1.0",
    "react-test-renderer": "19.1.0",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
